{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/blog",
      "destination": "/api/bunzy-blog"
    },
    {
      "source": "/api/blog/:slug",
      "destination": "/api/bunzy-blog?slug=:slug"
    },
    {
      "source": "/api/:path*",
      "destination": "https://api.tutienditavenezolana.com/api/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
