<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-src https://checkout.wompi.co; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://checkout.wompi.co; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://api.tutienditavenezolana.com; connect-src 'self' https://api.tutienditavenezolana.com https://www.google-analytics.com https://analytics.google.com"
  <FilesMatch "\.(js|css|webp|jpe?g|png|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Forzar HTTPS antes de servir archivos estáticos o aplicar el fallback SPA.
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # www -> dominio apex (canónico). El backend solo permite ese origen en
  # CORS, y www.* es un origin distinto: sin esto el catálogo no carga ahí.
  RewriteCond %{HTTP_HOST} ^www\.tutienditavenezolana\.com$ [NC]
  RewriteRule ^ https://tutienditavenezolana.com%{REQUEST_URI} [L,R=301]

  # El blog ya no vive en React: redirige /blog al subdominio de Bunzy Blog Hosting.
  RewriteRule ^blog/?(.*)$ https://blog.tutienditavenezolana.com/$1 [L,R=301]

  # Si la petición corresponde a un archivo o directorio real (assets, imágenes,
  # favicon.ico, etc.), sírvelo tal cual.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Cualquier otra ruta (/admin/login, /admin, /products, /cart, etc.) es
  # manejada por React Router: servir siempre index.html.
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
